# 文本文件统一 LF（优先级高于 core.autocrlf，所有平台 checkout 一致）
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.mp4 binary
# Windows 脚本必须 CRLF 才能执行
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
